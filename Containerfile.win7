FROM docker.io/library/fedora:40

RUN dnf install -y --setopt=install_weak_deps=False \
    mingw64-gcc \
    mingw64-gcc-c++ \
    mingw64-binutils \
    mingw64-crt \
    mingw64-headers \
    mingw64-winpthreads \
    mingw64-pixman \
    mingw64-zlib \
    mingw64-libffi \
    mingw64-gettext \
    mingw64-pcre \
    mingw64-pkg-config \
    meson \
    ninja-build \
    python3 \
    python3-pip \
    python3-setuptools \
    git \
    diffutils \
    gcc \
    gcc-c++ \
    bison \
    flex \
    which \
    cpio \
    curl \
    && dnf clean all

# Install GLib 2.66.8 and libffi 3.1 MinGW RPMs from Fedora Koji (last versions supporting Windows 7)
RUN rpm -Uvh --nodeps --oldpackage --replacefiles --replacepkgs \
    https://kojipkgs.fedoraproject.org/packages/mingw-glib2/2.66.8/1.fc33/noarch/mingw64-glib2-2.66.8-1.fc33.noarch.rpm \
    https://kojipkgs.fedoraproject.org/packages/mingw-libffi/3.1/10.fc33/noarch/mingw64-libffi-3.1-10.fc33.noarch.rpm
